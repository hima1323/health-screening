# Copy to .env and fill in. Never commit the filled-in file.
# Leave MONGODB_URI commented out to use a local MongoDB (mongodb://127.0.0.1:27017/aura_screen).
# For MongoDB Atlas, uncomment it and fill in your user and password; keep /aura_screen as the database.
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/aura_screen
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Google Identity Services — Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (type: Web application). Add the client origin below to that
# client's "Authorised JavaScript origins". No client secret is needed.
GOOGLE_CLIENT_ID=

# The demo doctor's email (npm run seed). Put your own Google address here to sign in
# at /doctor/login with Google; doctors are never created by signing in.
DEMO_DOCTOR_EMAIL=
